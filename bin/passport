#!/usr/bin/env node
'use strict';
// Passport の CLI。Node 標準ライブラリだけで動く。
//
//   passport login [--url https://passport.example.local] [--ca ca.pem] [--user NAME]
//   passport logout | whoami
//   passport vaults
//   passport ls <Vault>
//   passport read "<Vault>/<アイテム>[/<フィールド>]"     … フィールドの既定は password
//   passport totp "<Vault>/<アイテム>"
//   eval "$(passport ssh-agent [--lifetime 8h])"          … SSH エージェント（鍵を手元に持ってきて署名する）
//   eval "$(passport ssh-agent -k)"                       … 止める
//
// 名前は ID でも指定できる。名前に / を含むときは --vault / --item / --field で渡す。
//
// 認証は2通り:
//   ・人: passport login で対話ログイン。サーバーのセッション（既定8時間、最長24時間）を
//         ~/.config/passport/session.json に 0600 で保存する
//   ・自動化: 自動化トークン（pp_...）を PASSPORT_TOKEN_FILE（0600 のファイル。勧める）か PASSPORT_TOKEN で渡す。
//     コマンドラインに直接書くとシェルの履歴に残るので、ファイルで渡す
//
// 接続先と証明書: --url / --ca、環境変数 PASSPORT_URL / PASSPORT_CA、または ~/.config/passport/config.json。
// 自己署名の証明書は --ca で CA（または証明書そのもの）のファイルを渡す。検証を切る手段は用意しない。

const fs = require('fs');
const os = require('os');
const path = require('path');
const http = require('http');
const https = require('https');

const EXIT = { ok: 0, error: 1, usage: 2, auth: 3 };
// SSH エージェントとして鍵を取り出すときは、サーバーの監査ログで read と見分けられるように名乗る
let AGENT_CLIENT = false;
const SECRET_FIELDS = /^(password|totp|note|privateKey|passphrase|custom:[A-Za-z0-9_-]{1,64})$/;

class CliError extends Error {
  constructor(message, code = EXIT.error) {
    super(message);
    this.exitCode = code;
  }
}

// --- 引数 --------------------------------------------------------------------

function parseArgs(argv) {
  const positional = [];
  const options = {};
  for (let i = 0; i < argv.length; i += 1) {
    const arg = argv[i];
    if (arg === '-h' || arg === '--help') {
      options.help = true;
    } else if (arg === '-k') {
      options.kill = true;
    } else if (arg.startsWith('--')) {
      const eq = arg.indexOf('=');
      if (eq > 0) {
        options[arg.slice(2, eq)] = arg.slice(eq + 1);
      } else if (i + 1 < argv.length && !argv[i + 1].startsWith('--')) {
        options[arg.slice(2)] = argv[i + 1];
        i += 1;
      } else {
        options[arg.slice(2)] = true;
      }
    } else {
      positional.push(arg);
    }
  }
  return { positional, options };
}

// --- 設定とセッションのファイル ---------------------------------------------------

function configDir() {
  const base = process.env.XDG_CONFIG_HOME || path.join(os.homedir(), '.config');
  return path.join(base, 'passport');
}

function ensureConfigDir() {
  const dir = configDir();
  fs.mkdirSync(dir, { recursive: true, mode: 0o700 });
  fs.chmodSync(dir, 0o700);
  return dir;
}

function readPrivateJson(file) {
  if (!fs.existsSync(file)) return null;
  const mode = fs.statSync(file).mode & 0o777;
  if (mode & 0o077) {
    throw new CliError(`${file} がほかの人から読める権限になっています（${mode.toString(8)}）。chmod 600 にするか、消してログインし直してください`);
  }
  try {
    return JSON.parse(fs.readFileSync(file, 'utf8'));
  } catch {
    throw new CliError(`${file} を読めません。消してログインし直してください`);
  }
}

function writePrivateJson(file, data) {
  ensureConfigDir();
  const tmp = `${file}.tmp-${process.pid}`;
  fs.writeFileSync(tmp, `${JSON.stringify(data, null, 2)}\n`, { mode: 0o600 });
  fs.chmodSync(tmp, 0o600);
  fs.renameSync(tmp, file);
}

const configFile = () => path.join(configDir(), 'config.json');
const sessionFile = () => path.join(configDir(), 'session.json');

function resolveTarget(options) {
  const saved = readPrivateJson(configFile()) || {};
  const url = options.url || process.env.PASSPORT_URL || saved.url;
  const ca = options.ca || process.env.PASSPORT_CA || saved.caFile || null;
  if (!url) throw new CliError('接続先が決まっていません。--url か PASSPORT_URL で指定してください', EXIT.usage);
  let parsed;
  try {
    parsed = new URL(url);
  } catch {
    throw new CliError(`接続先の URL を解釈できません: ${url}`, EXIT.usage);
  }
  if (!['https:', 'http:'].includes(parsed.protocol)) throw new CliError('接続先は https:// で指定してください', EXIT.usage);
  // http は手元（loopback）だけ。ほかは --allow-http（または PASSPORT_ALLOW_HTTP=1）を明示したときだけ通す。
  // cron では警告を誰も見ないので、警告だけでは、トークンと秘密が毎回平文で流れ続けることになる
  if (parsed.protocol === 'http:' && !['localhost', '127.0.0.1', '[::1]'].includes(parsed.hostname)) {
    if (!options['allow-http'] && process.env.PASSPORT_ALLOW_HTTP !== '1') {
      throw new CliError('http:// ではパスワードとトークンが平文でネットワークを流れるので接続しません。https:// を使ってください'
        + '（どうしても必要なら --allow-http）', EXIT.usage);
    }
    process.stderr.write('警告: http で接続します。パスワードとトークンが平文でネットワークを流れます\n');
  }
  return { url: parsed.origin, ca, hostname: parsed.hostname.replace(/^\[|\]$/g, '') };
}

// --- HTTP --------------------------------------------------------------------

function request(target, method, pathname, { body, bearer, headers = {} } = {}) {
  const base = new URL(target.url);
  const lib = base.protocol === 'https:' ? https : http;
  const payload = body === undefined ? null : Buffer.from(JSON.stringify(body));
  const options = {
    method,
    hostname: base.hostname.replace(/^\[|\]$/g, ''), // IPv6 の [::1] は角かっこを外して渡す
    port: base.port || (base.protocol === 'https:' ? 443 : 80),
    path: pathname,
    headers: {
      Accept: 'application/json',
      'User-Agent': `passport-cli node/${process.versions.node}`,
      'X-Passport-Client': AGENT_CLIENT ? 'cli-agent' : 'cli',
      ...(payload ? { 'Content-Type': 'application/json', 'Content-Length': payload.length } : {}),
      // ログインと書き込みは Origin を確かめられる（CSRF 対策）。接続先そのものを名乗る
      Origin: target.url,
      ...(bearer ? { Authorization: `Bearer ${bearer}` } : {}),
      ...headers
    },
    timeout: 15000
  };
  if (base.protocol === 'https:' && target.ca) {
    try {
      options.ca = fs.readFileSync(target.ca);
    } catch (err) {
      throw new CliError(`CA のファイルを読めません: ${target.ca}: ${err.message}`, EXIT.usage);
    }
  }
  return new Promise((resolve, reject) => {
    const req = lib.request(options, (res) => {
      const chunks = [];
      res.on('data', (c) => chunks.push(c));
      res.on('end', () => {
        const text = Buffer.concat(chunks).toString('utf8');
        let json = null;
        try {
          json = JSON.parse(text);
        } catch {
          // JSON でない
        }
        resolve({ status: res.statusCode, json, text });
      });
    });
    req.on('timeout', () => req.destroy(new Error('応答がありません（15秒）')));
    req.on('error', (err) => {
      if (/self[- ]signed|unable to verify|UNABLE_TO_GET_ISSUER|DEPTH_ZERO/i.test(`${err.code} ${err.message}`)) {
        reject(new CliError(`サーバーの証明書を確かめられません（${err.code || err.message}）。自己署名なら --ca で証明書のファイルを渡してください`));
      } else {
        reject(new CliError(`接続できません: ${err.message}`));
      }
    });
    if (payload) req.write(payload);
    req.end();
  });
}

async function api(ctx, method, pathname, body) {
  const res = await request(ctx.target, method, pathname, { body, bearer: ctx.bearer });
  if (res.status === 401) {
    throw new CliError(ctx.kind === 'token'
      ? 'トークンが使えません（期限切れ・失効・権限の変更など）'
      : 'ログインが切れています。passport login でログインし直してください', EXIT.auth);
  }
  if (res.status >= 400) {
    throw new CliError((res.json && res.json.error) || `サーバーがエラーを返しました（${res.status}）`);
  }
  return res.json;
}

// --- 認証情報 -----------------------------------------------------------------

function tokenFromFile() {
  const file = process.env.PASSPORT_TOKEN_FILE;
  if (!file) return null;
  let stat;
  try {
    stat = fs.statSync(file);
  } catch {
    throw new CliError(`PASSPORT_TOKEN_FILE のファイルがありません: ${file}`, EXIT.usage);
  }
  if (stat.mode & 0o077) {
    throw new CliError(`${file} がほかの人から読める権限になっています（${(stat.mode & 0o777).toString(8)}）。chmod 600 にしてください`, EXIT.usage);
  }
  return fs.readFileSync(file, 'utf8').trim();
}

function loadCredential(options) {
  const token = tokenFromFile() || (process.env.PASSPORT_TOKEN ? process.env.PASSPORT_TOKEN.trim() : null);
  if (token) {
    return { kind: 'token', bearer: token, target: resolveTarget(options) };
  }
  const saved = readPrivateJson(sessionFile());
  if (!saved || !saved.token) throw new CliError('ログインしていません。passport login でログインしてください', EXIT.auth);
  // 期限は手元では判断しない。サーバーは操作のたびに延ばす（最長 24 時間）ので、切れていれば 401 で分かる
  const target = resolveTarget({ ...options, url: options.url || saved.url });
  return { kind: 'user', bearer: saved.token, target };
}

function prompt(question, { hidden = false } = {}) {
  return new Promise((resolve, reject) => {
    const stdin = process.stdin;
    if (hidden && !stdin.isTTY) {
      // パイプで渡された場合（テストや、パスワードマネージャーからの受け渡し）
      let data = '';
      stdin.setEncoding('utf8');
      stdin.on('data', (c) => { data += c; });
      stdin.on('end', () => resolve(data.replace(/\r?\n$/, '')));
      stdin.on('error', reject);
      return;
    }
    process.stderr.write(question);
    if (!hidden) {
      const rl = require('readline').createInterface({ input: stdin, output: process.stderr, terminal: false });
      rl.once('line', (line) => { rl.close(); resolve(line); });
      return;
    }
    let value = '';
    stdin.setRawMode(true);
    stdin.resume();
    stdin.setEncoding('utf8');
    const onData = (chunk) => {
      for (const ch of chunk) {
        if (ch === '\r' || ch === '\n' || ch === '') {
          stdin.setRawMode(false);
          stdin.pause();
          stdin.removeListener('data', onData);
          process.stderr.write('\n');
          resolve(value);
          return;
        }
        if (ch === '') {
          stdin.setRawMode(false);
          process.stderr.write('\n');
          reject(new CliError('中止しました'));
          return;
        }
        if (ch === '' || ch === '\b') value = value.slice(0, -1);
        else value += ch;
      }
    };
    stdin.on('data', onData);
  });
}

// --- 名前の解決 ---------------------------------------------------------------

function pickOne(list, wanted, what, label) {
  const byId = list.filter((x) => x.id === wanted);
  if (byId.length === 1) return byId[0];
  const byName = list.filter((x) => label(x) === wanted);
  if (byName.length === 1) return byName[0];
  if (byName.length > 1) {
    throw new CliError(`「${wanted}」という${what}が ${byName.length} 個あります。ID で指定してください:\n`
      + byName.map((x) => `  ${x.id}`).join('\n'));
  }
  throw new CliError(`${what}「${wanted}」が見つかりません`);
}

function splitRef(ref, options, { withField }) {
  if (options.vault || options.item) {
    return { vault: options.vault, item: options.item, field: options.field || null };
  }
  const parts = String(ref || '').split('/');
  if (parts.length < 2) throw new CliError('"<Vault>/<アイテム>" の形で指定してください', EXIT.usage);
  if (withField && parts.length >= 3) {
    return { vault: parts[0], item: parts.slice(1, -1).join('/'), field: parts[parts.length - 1] };
  }
  return { vault: parts[0], item: parts.slice(1).join('/'), field: null };
}

async function resolveItem(ctx, ref, options, { withField }) {
  const parsed = splitRef(ref, options, { withField });
  const { vaults } = await api(ctx, 'GET', '/api/automation/vaults');
  const vault = pickOne(vaults, parsed.vault, 'Vault', (v) => v.name);
  const { items } = await api(ctx, 'GET', `/api/automation/vaults/${encodeURIComponent(vault.id)}/items`);
  const item = pickOne(items, parsed.item, 'アイテム', (i) => i.title);
  return { vault, item, field: parsed.field };
}

function writeValue(value) {
  // 端末に出すときだけ改行を付ける。$(passport read ...) では末尾の改行が混ざらないように
  process.stdout.write(process.stdout.isTTY ? `${value}\n` : String(value));
}


// --- SSH エージェント -----------------------------------------------------------
//
// 本人の決定: 鍵を端末に持ってくる。起動時に、読める SSH 鍵を Passport から取り出してメモリに持ち、
// 署名は手元で行う。取り出しは鍵ごとに監査ログに残るが、個々の署名は残らない。
// 寿命（既定 8 時間、最長 24 時間）が来たら鍵を捨てて終わる。

const MAX_AGENT_LIFETIME_MS = 24 * 60 * 60 * 1000;

function parseLifetime(text) {
  if (text === undefined || text === true) return 8 * 60 * 60 * 1000;
  const match = /^(\d+)\s*(s|m|h|d)?$/.exec(String(text).trim());
  if (!match) throw new CliError('--lifetime は 30m / 8h / 1d のように指定してください', EXIT.usage);
  const unit = { s: 1000, m: 60 * 1000, h: 60 * 60 * 1000, d: 24 * 60 * 60 * 1000 }[match[2] || 'h'];
  const ms = Number(match[1]) * unit;
  if (ms < 1000) throw new CliError('--lifetime が短すぎます', EXIT.usage);
  if (ms > MAX_AGENT_LIFETIME_MS) throw new CliError('--lifetime は最長 24 時間です', EXIT.usage);
  return ms;
}

function shellQuote(value) {
  return `'${String(value).replace(/'/g, `'\\''`)}'`;
}

function evalLines(socketPath, pid) {
  return `SSH_AUTH_SOCK=${shellQuote(socketPath)}; export SSH_AUTH_SOCK;\nSSH_AGENT_PID=${pid}; export SSH_AGENT_PID;\n`;
}

// 読める Vault から SSH 鍵を集める。取り出しはサーバーの監査ログに鍵ごとに残る。
// --vault を渡すと、その Vault の鍵だけを持ってくる（取り出す本数がそのまま端末への露出範囲になるため）
async function collectSshKeys(ctx, log, { vaultNames = [] } = {}) {
  let sshagent;
  try {
    sshagent = require(path.join(__dirname, '..', 'lib', 'sshagent'));
  } catch (err) {
    if (err.code !== 'MODULE_NOT_FOUND') throw err;
    throw new CliError('SSH エージェントには bin/passport と一緒に lib/sshagent.js と lib/sshkeys.js が要ります'
      + '（リポジトリと同じ bin/ と lib/ の並びで置いてください）', EXIT.usage);
  }
  const loaded = [];
  const skipped = [];
  const { vaults: all } = await api(ctx, 'GET', '/api/automation/vaults');
  const vaults = vaultNames.length ? vaultNames.map((name) => pickOne(all, name, 'Vault', (v) => v.name)) : all;
  for (const vault of vaults) {
    const { items } = await api(ctx, 'GET', `/api/automation/vaults/${encodeURIComponent(vault.id)}/items`);
    for (const item of items.filter((i) => i.type === 'sshkey' && i.fields.includes('privateKey'))) {
      const label = `${vault.name}/${item.title}`;
      const read = async (field) => (await api(ctx, 'POST',
        `/api/automation/vaults/${encodeURIComponent(vault.id)}/items/${encodeURIComponent(item.id)}/read`, { field })).value;
      try {
        const privateKey = await read('privateKey');
        const passphrase = item.fields.includes('passphrase') ? await read('passphrase') : null;
        const entry = sshagent.loadPrivateKey(privateKey, { passphrase, comment: label });
        const same = loaded.find((k) => k.publicBlob.equals(entry.publicBlob));
        if (same) {
          log(`  - ${label}: ${same.comment} と同じ鍵なので1本にまとめました`);
          continue;
        }
        loaded.push(entry);
        log(`  ✓ ${label}  ${entry.fingerprint}`);
      } catch (err) {
        if (err instanceof CliError) throw err;
        skipped.push({ label, reason: err.message });
        log(`  ✗ ${label}: ${err.message}`);
      }
    }
  }
  return { loaded, skipped, sshagent };
}

// ソケットの置き場所を、鍵を取り出す前に決めて確かめる（失敗する起動で鍵を取り出さないため）
function decideSocket(options) {
  if (options.socket !== undefined) {
    if (options.socket === true || !String(options.socket).trim()) throw new CliError('--socket にパスを指定してください', EXIT.usage);
    // 絶対パスにする。数字だけの値が TCP のポートと解釈されるのを防ぎ、cd しても壊れない SSH_AUTH_SOCK にする
    const socketPath = path.resolve(String(options.socket));
    if (fs.existsSync(socketPath)) throw new CliError(`${socketPath} はすでにあります`, EXIT.usage);
    if (Buffer.byteLength(socketPath) > 100) throw new CliError(`ソケットのパスが長すぎます: ${socketPath}`, EXIT.usage);
    return { socketPath, dir: null };
  }
  const base = Buffer.byteLength(os.tmpdir()) > 60 ? '/tmp' : os.tmpdir();
  const dir = fs.mkdtempSync(path.join(base, 'passport-agent-'));
  fs.chmodSync(dir, 0o700);
  return { socketPath: path.join(dir, 'agent.sock'), dir };
}

function vaultOption(options) {
  if (options.vault === undefined) return [];
  if (options.vault === true) throw new CliError('--vault に Vault の名前か ID を指定してください', EXIT.usage);
  return String(options.vault).split(',').map((v) => v.trim()).filter(Boolean);
}

// バックグラウンド起動の子は、自動化トークンを環境変数ではなく標準入力で受け取る。
// 環境変数のままだと、寿命いっぱい /proc/<pid>/environ から同じユーザーに読めてしまうため
function readTokenFromStdin() {
  return new Promise((resolve, reject) => {
    let data = '';
    process.stdin.setEncoding('utf8');
    process.stdin.on('data', (c) => { data += c; });
    process.stdin.on('end', () => resolve(data.trim()));
    process.stdin.on('error', reject);
  });
}

async function runAgent(options) {
  const ready = !!options['ready-pipe']; // 親（バックグラウンド起動）に準備できたことを知らせる
  const lifetime = parseLifetime(options.lifetime);
  const vaultNames = vaultOption(options);
  let quiet = false;
  const log = (line) => {
    if (!quiet) process.stderr.write(`${line}\n`);
  };
  for (const stream of [process.stdout, process.stderr]) stream.on('error', () => { quiet = true; });

  if (options['token-stdin']) {
    const token = await readTokenFromStdin();
    if (token) process.env.PASSPORT_TOKEN = token; // このプロセスの中だけ。/proc の初期環境には載らない
  }
  const ctx = loadCredential(options);
  AGENT_CLIENT = true;
  const { socketPath, dir } = decideSocket(options);
  const cleanupDir = () => {
    if (dir) {
      try { fs.rmdirSync(dir); } catch { /* 消えている */ }
    }
  };

  let loaded;
  let skipped;
  let sshagent;
  try {
    log('Passport から SSH 鍵を取り出しています（取り出しは監査ログに残ります）');
    ({ loaded, skipped, sshagent } = await collectSshKeys(ctx, log, { vaultNames }));
    if (loaded.length === 0) {
      throw new CliError(`使える SSH 鍵がありませんでした${skipped.length ? `（読み飛ばし ${skipped.length} 本）` : ''}`);
    }
  } catch (err) {
    cleanupDir();
    throw err;
  }

  let keys = loaded;
  let server;
  try {
    server = await sshagent.listen(socketPath, { list: () => keys, onSign: () => {} });
  } catch (err) {
    cleanupDir();
    throw new CliError(`ソケットを開けません: ${err.message}`);
  }

  let finished = false;
  const finish = (reason, code = 0) => {
    if (finished) return;
    finished = true;
    keys = []; // 鍵を捨てる（KeyObject そのものは GC に任せる）
    loaded.length = 0;
    try { server.close(); } catch { /* 閉じている */ }
    try { fs.unlinkSync(socketPath); } catch { /* 消えている */ }
    cleanupDir();
    log(`SSH エージェントを終了しました（${reason}）`);
    process.exit(code);
  };
  setTimeout(() => finish('寿命'), lifetime);
  for (const signal of ['SIGTERM', 'SIGINT', 'SIGHUP']) process.on(signal, () => finish(signal));
  // 想定外の失敗でも、ソケットとディレクトリを残さない
  server.on('error', (err) => finish(`ソケットのエラー: ${err.message}`, 1));
  process.on('uncaughtException', (err) => finish(`想定外のエラー: ${err.message}`, 1));

  const until = new Date(Date.now() + lifetime);
  const sameDay = until.toDateString() === new Date().toDateString();
  const hhmm = `${sameDay ? '' : '翌日の'}${String(until.getHours()).padStart(2, '0')}:${String(until.getMinutes()).padStart(2, '0')}`;
  const summary = `鍵 ${keys.length} 本を読み込みました${skipped.length ? `（読み飛ばし ${skipped.length} 本）` : ''}。`
    + `${hhmm} に鍵を捨てて終わります`;
  if (ready) {
    process.stdout.write(`${JSON.stringify({ socket: socketPath, pid: process.pid, summary })}\n`);
    process.stdout.end();
    quiet = true; // 親は終わるので、これ以降は書かない
  } else {
    process.stdout.write(evalLines(socketPath, process.pid));
    log(summary);
  }
}

async function startAgentInBackground(options) {
  const { spawn } = require('child_process');
  const args = [__filename, 'ssh-agent', '--foreground', '--ready-pipe'];
  for (const name of ['lifetime', 'socket', 'url', 'ca', 'allow-http', 'vault']) {
    if (options[name] === true) args.push(`--${name}`);
    else if (options[name] !== undefined) args.push(`--${name}`, String(options[name]));
  }
  // ソケットのパスは親で絶対パスにしてから渡す（子の作業ディレクトリに依らないように）
  if (options.socket !== undefined && options.socket !== true) {
    args[args.indexOf('--socket') + 1] = path.resolve(String(options.socket));
  }
  const env = { ...process.env };
  const token = env.PASSPORT_TOKEN;
  delete env.PASSPORT_TOKEN;
  if (token) args.push('--token-stdin');
  const child = spawn(process.execPath, args, { detached: true, stdio: ['pipe', 'pipe', 'pipe'], env });
  child.stdin.end(token ? `${token}\n` : '');
  let out = '';
  child.stderr.on('data', (d) => process.stderr.write(d));
  child.stdout.on('data', (d) => { out += d; });
  await new Promise((resolve, reject) => {
    child.stdout.on('end', () => {
      const line = out.split('\n').find((l) => l.startsWith('{'));
      if (!line) return;
      let info;
      try {
        info = JSON.parse(line);
      } catch {
        try { process.kill(child.pid, 'SIGTERM'); } catch { /* 終わっている */ }
        reject(new CliError('SSH エージェントの起動を確かめられませんでした'));
        return;
      }
      process.stdout.write(evalLines(info.socket, info.pid));
      process.stdout.write(`echo ${shellQuote(`Passport SSH エージェント（pid ${info.pid}）`)} >&2;\n`);
      process.stderr.write(`${info.summary}\n`);
      child.stderr.destroy();
      child.unref();
      resolve();
    });
    child.on('exit', (code) => reject(new CliError('SSH エージェントを起動できませんでした', code || EXIT.error)));
  });
}

function killAgent() {
  const pid = Number(process.env.SSH_AGENT_PID);
  if (!Number.isInteger(pid) || pid <= 1) throw new CliError('SSH_AGENT_PID が設定されていません', EXIT.usage);
  // 別のプログラム（本物の ssh-agent など）を誤って止めないよう、Passport のエージェントかを確かめる（Linux の /proc を使う）
  let argv;
  try {
    argv = fs.readFileSync(`/proc/${pid}/cmdline`, 'utf8').split('\0').filter(Boolean);
  } catch {
    throw new CliError(`pid ${pid} のプロセスが見つかりません（-k は Linux の /proc で確かめます）`);
  }
  const isAgent = argv.length >= 3 && path.basename(argv[1]) === 'passport' && argv[2] === 'ssh-agent' && argv.includes('--foreground');
  if (!isAgent) throw new CliError(`pid ${pid} は Passport の SSH エージェントではありません`);
  process.kill(pid, 'SIGTERM');
  process.stdout.write(`unset SSH_AUTH_SOCK;\nunset SSH_AGENT_PID;\necho ${shellQuote(`Passport SSH エージェント（pid ${pid}）を止めました`)} >&2;\n`);
}

// --- コマンド -----------------------------------------------------------------

const commands = {
  async login(args, options) {
    if (process.env.PASSPORT_TOKEN || process.env.PASSPORT_TOKEN_FILE) {
      throw new CliError('PASSPORT_TOKEN / PASSPORT_TOKEN_FILE が設定されています。人としてログインするなら外してください', EXIT.usage);
    }
    const target = resolveTarget(options);
    // 端末でないときは、ユーザー名を --user で渡してもらう（標準入力はパスワードだけに使う）
    if (!options.user && !process.stdin.isTTY) {
      throw new CliError('端末でないときは --user でユーザー名を渡してください（パスワードは標準入力から読みます）', EXIT.usage);
    }
    const username = options.user || await prompt('ユーザー名: ');
    const password = await prompt('パスワード: ', { hidden: true });
    // 空のパスワードをサーバーへ送らない（ログイン失敗として数えられ、接続元が止められてしまう）
    if (!password) throw new CliError('パスワードが空です', EXIT.usage);
    const res = await request(target, 'POST', '/api/login', { body: { username, password } });
    if (res.status !== 200 || !res.json || !res.json.token) {
      throw new CliError((res.json && res.json.error) || `ログインできませんでした（${res.status}）`, EXIT.auth);
    }
    if (res.json.mustChangePassword) {
      process.stderr.write('初期パスワードのままです。画面からログインしてパスワードを変えてください\n');
    }
    writePrivateJson(configFile(), { url: target.url, caFile: target.ca ? path.resolve(target.ca) : null });
    writePrivateJson(sessionFile(), {
      url: target.url,
      username: res.json.user.username,
      token: res.json.token,
      loggedInAt: new Date().toISOString()
    });
    process.stderr.write(`${res.json.user.username} としてログインしました\n`);
  },

  async logout(args, options) {
    const file = sessionFile();
    const saved = fs.existsSync(file) ? readPrivateJson(file) : null;
    if (saved && saved.token) {
      try {
        const target = resolveTarget({ ...options, url: options.url || saved.url });
        await request(target, 'POST', '/api/logout', { body: {}, bearer: saved.token });
      } catch {
        // サーバーに届かなくても、手元のトークンは消す
      }
    }
    if (fs.existsSync(file)) fs.unlinkSync(file);
    process.stderr.write('ログアウトしました\n');
  },

  async whoami(args, options) {
    const ctx = loadCredential(options);
    const me = await api(ctx, 'GET', '/api/automation/whoami');
    if (me.kind === 'token') console.log(`自動化トークン「${me.name}」（期限 ${me.expiresAt}）`);
    else console.log(`${me.username}（ログインの期限 ${me.expiresAt}）`);
  },

  async vaults(args, options) {
    const ctx = loadCredential(options);
    const { vaults } = await api(ctx, 'GET', '/api/automation/vaults');
    for (const v of vaults) console.log(`${v.id}\t${v.role}\t${v.itemCount}件\t${v.name}`);
  },

  async ls(args, options) {
    const ctx = loadCredential(options);
    const wanted = options.vault || args[0];
    if (!wanted) throw new CliError('passport ls <Vault>', EXIT.usage);
    const { vaults } = await api(ctx, 'GET', '/api/automation/vaults');
    const vault = pickOne(vaults, wanted, 'Vault', (v) => v.name);
    const { items } = await api(ctx, 'GET', `/api/automation/vaults/${encodeURIComponent(vault.id)}/items`);
    for (const i of items) console.log(`${i.id}\t${i.type}\t${i.title}\t${i.username || ''}\t${i.fields.join(',')}`);
  },

  async read(args, options) {
    const ctx = loadCredential(options);
    const { vault, item, field: refField } = await resolveItem(ctx, args[0], options, { withField: true });
    const field = refField || 'password';
    if (field === 'username') {
      writeValue(item.username || '');
      return;
    }
    if (!SECRET_FIELDS.test(field)) throw new CliError(`フィールド「${field}」は読めません（password / note / totp / privateKey / passphrase / username / custom:...）`, EXIT.usage);
    if (!item.fields.includes(field)) throw new CliError(`「${item.title}」に ${field} はありません（あるもの: ${item.fields.join(', ') || 'なし'}）`);
    const { value } = await api(ctx, 'POST',
      `/api/automation/vaults/${encodeURIComponent(vault.id)}/items/${encodeURIComponent(item.id)}/read`, { field });
    writeValue(value);
  },

  async 'ssh-agent'(args, options) {
    if (options.kill) {
      killAgent();
      return;
    }
    if (options.foreground) {
      await runAgent(options);
      return;
    }
    await startAgentInBackground(options);
  },

  async totp(args, options) {
    const ctx = loadCredential(options);
    const { vault, item } = await resolveItem(ctx, args[0], options, { withField: false });
    const result = await api(ctx, 'POST',
      `/api/automation/vaults/${encodeURIComponent(vault.id)}/items/${encodeURIComponent(item.id)}/totp`, {});
    writeValue(result.code);
  }
};

const HELP = `使い方:
  passport login [--url URL] [--ca CA.pem] [--user NAME]   対話ログイン
  passport logout                                           ログアウト（手元のトークンも消す）
  passport whoami                                           誰として使っているか
  passport vaults                                           読める Vault の一覧
  passport ls <Vault>                                       アイテムの一覧（ID・種別・タイトル・ユーザー名・フィールド）
  passport read "<Vault>/<アイテム>[/<フィールド>]"         秘密を1つ出す（既定は password）
  passport totp "<Vault>/<アイテム>"                        ワンタイムパスワードを出す
  eval "$(passport ssh-agent [--lifetime 8h])"              SSH エージェントを起動（読める SSH 鍵を手元に持ってくる）
  eval "$(passport ssh-agent -k)"                           SSH エージェントを止める
      --foreground で手前で動かす。--lifetime は最長 24h（過ぎたら鍵を捨てて終わる）
      --vault で持ってくる Vault を絞る（カンマ区切り）。--socket でソケットの場所を決める

  名前に / を含むときは --vault / --item / --field で渡す。名前の代わりに ID も使える。
  自動化では PASSPORT_TOKEN_FILE に自動化トークンを書いた 0600 のファイルを渡す（PASSPORT_TOKEN でも可。履歴に残りやすい）。
  接続先: --url / PASSPORT_URL、証明書: --ca / PASSPORT_CA（http:// は手元だけ。ほかは --allow-http が要る）
  秘密を出したことは、サーバーの監査ログに残る。`;

async function main() {
  const { positional, options } = parseArgs(process.argv.slice(2));
  const [name, ...rest] = positional;
  if (!name || options.help || !commands[name]) {
    process.stderr.write(`${HELP}\n`);
    process.exit(name && !commands[name] ? EXIT.usage : EXIT.ok);
  }
  await commands[name](rest, options);
}

main().catch((err) => {
  process.stderr.write(`passport: ${err instanceof CliError ? err.message : err.stack}\n`);
  process.exit(err instanceof CliError ? err.exitCode : EXIT.error);
});
