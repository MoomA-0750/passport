; Passport 設定ファイル。passport.ini としてプロジェクトルートに置く。
; 環境変数が最優先、次にこのファイル、最後に既定値。

[server]
port = 3443
host = 0.0.0.0

; TLS を Node 自身で終端する場合は on。
; Nginx をリバースプロキシにして前段で終端する場合は off にし、
; host = 127.0.0.1 にして外から直接叩けないようにする。
tls = on
tlsKey = ./tls/server.key
tlsCert = ./tls/server.crt

; Nginx 前段構成のときだけ on。X-Forwarded-Proto を信頼する。
trustProxy = off

[storage]
dataDir = ./data

[crypto]
; マスターキーの在処。data/ の外、バックアップ対象外の場所に置く。
; 環境変数 PASSPORT_MASTER_PASSPHRASE を与えた場合はそちらが優先され、
; このファイルは使われない（起動ごとに人手でアンロックする運用）。
masterKeyFile = /etc/passport/master.key

[session]
; セッションの有効期限（時間）。操作があるたびに延びる。金庫なので短めが既定。
expireHours = 8
; 操作が続いていても、ログインからこの時間が経ったら切る（延長の上限）。
absoluteMaxHours = 24
; 無操作で画面をロックするまでの分数（クライアント側）。
idleLockMinutes = 15

[auth]
; 同じユーザー名を同じ接続元から、この回数続けて失敗したら、その組み合わせだけを止める。
; 別の場所から正しいパスワードで入る本人には効かない（締め出し攻撃を防ぐため）。
maxFailedAttempts = 5
lockoutMinutes = 15
; 新規ユーザーに要求するパスワードの最低文字数。
minPasswordLength = 12

[audit]
enabled = true

[extension]
; Chrome 拡張からの API 利用。切ると拡張からのリクエストを CORS で弾く。
enabled = on
; 受け付ける拡張ID。extension/manifest.json の key で固定してあるので既定のままで動く。
; 拡張を作り直して ID が変わったら、chrome://extensions で見える ID に書き換える。
; 空にすると、どの拡張からでも通ってしまうので空にしない。
allowedIds = iookbapfomcndnncbdohnhblclbhmfoc

[cli]
; 人の CLI（passport login）を許す。拡張と違って呼び出し元を絞れないので、使わないなら off にする。
enabled = on
; 自動化トークン（cron などから PASSPORT_TOKEN で読む）を許す。off にすると発行済みのトークンも使えなくなる。
tokens = on
